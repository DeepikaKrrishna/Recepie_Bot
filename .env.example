# Copy to .env for local development:  cp .env.example .env
# In production, set these in your hosting provider's environment settings instead.
# Never commit a real .env file.

# --- App ---
# development | production  (production enables HSTS and hides /docs)
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty when the frontend is served by this app (the default setup).
ALLOWED_ORIGINS=
# Set to true only when running behind a trusted reverse proxy (Render, Railway, Fly, nginx)
# so the client IP is taken from X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# --- OpenRouter (server-side only; never exposed to the browser) ---
OPENROUTER_API_KEY=your-openrouter-key-here
# Primary model. Check current availability at https://openrouter.ai/models
OPENROUTER_MODEL=google/gemma-3-4b-it:free
# Optional comma-separated fallbacks tried when the primary model is unavailable.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2
# Sent to OpenRouter as attribution headers (optional)
APP_PUBLIC_URL=http://localhost:8000
APP_TITLE=Recipe Bot

# --- Limits ---
# Requests per minute, per client IP, for AI-backed endpoints
AI_RATE_LIMIT_PER_MINUTE=8
# Maximum accepted request body size in bytes
MAX_REQUEST_BYTES=16384

# --- Preferences ---
DEFAULT_CURRENCY=INR

# --- Database ---
# Local default (when unset): SQLite file recipebot.sqlite3 in the project folder.
# Production: the PostgreSQL URL from your host (postgres:// and postgresql:// both work).
DATABASE_URL=
# --- Accounts ---
SESSION_DAYS=30
# Default days to keep recipe-generation history for new accounts (0 = don't keep)
HISTORY_RETENTION_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=8
