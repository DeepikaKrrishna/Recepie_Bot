# Copy to .env for local development:  cp .env.example .env   (Windows: copy .env.example .env)
# In production, set these in your hosting provider's environment settings instead.
# Never commit a real .env file.

# --- AI provider (server-side only; the key is never sent to the browser) ---
# Free key: https://console.groq.com/keys  -> paste it below. That's all you need.
GROQ_API_KEY=
# Optional: groq (default) | gemini | openrouter. Setting GEMINI_API_KEY or
# OPENROUTER_API_KEY instead of GROQ_API_KEY also picks that provider.
AI_PROVIDER=
# Optional overrides. Default model for Groq: llama-3.3-70b-versatile
AI_MODEL=
# Comma-separated models tried if the primary one is unavailable, e.g. llama-3.1-8b-instant
AI_FALLBACK_MODELS=
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# --- App ---
# development | production  (production enables HSTS, secure cookies and hides /docs)
APP_ENV=development
LOG_LEVEL=INFO
APP_PUBLIC_URL=http://localhost:8000
APP_TITLE=Recipe Bot
# Comma-separated origins allowed to call the API cross-origin. Leave empty (frontend is served by this app).
ALLOWED_ORIGINS=
# true only behind a trusted reverse proxy (Render, Railway, Fly, nginx) so rate limits see the real client IP.
TRUST_PROXY=false

# --- Limits ---
# AI recipe requests per minute, per user and per IP
AI_RATE_LIMIT_PER_MINUTE=8
MAX_REQUEST_BYTES=16384
LOGIN_RATE_LIMIT_PER_MINUTE=8

# --- Database & accounts ---
# Empty = SQLite file recipebot.sqlite3 in the project folder.
# Production: your PostgreSQL URL (postgres:// and postgresql:// both work).
DATABASE_URL=
SESSION_DAYS=30
